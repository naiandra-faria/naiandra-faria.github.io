{
  "$schema": "https://design-tokens.org/schema.json",
  "meta": {
    "name": "nai.design",
    "owner": "Naiandra Madhallena",
    "version": "1.0.0",
    "source": "naiandra-faria.github.io/index.html"
  },
  "color": {
    "primitive": {
      "cream":       { "$type": "color", "$value": "#FAF7F0" },
      "cream-dark":  { "$type": "color", "$value": "#F0EBE0" },
      "pink-light":  { "$type": "color", "$value": "#FDE8EC" },
      "pink":        { "$type": "color", "$value": "#F2B8C0" },
      "pink-deep":   { "$type": "color", "$value": "#E8909D" },
      "yellow-light":{ "$type": "color", "$value": "#FDF5CC" },
      "yellow":      { "$type": "color", "$value": "#F0C93A" },
      "marsala":     { "$type": "color", "$value": "#8B1A2E" },
      "ink":         { "$type": "color", "$value": "#1C1410" },
      "ink-surface": { "$type": "color", "$value": "#2A1A1A" },
      "grey":        { "$type": "color", "$value": "#8A7A6A" },
      "white":       { "$type": "color", "$value": "#FFFFFF" }
    },
    "semantic": {
      "bg-default":     { "$type": "color", "$value": "{color.primitive.cream}" },
      "bg-subtle":      { "$type": "color", "$value": "{color.primitive.cream-dark}" },
      "bg-accent-soft": { "$type": "color", "$value": "{color.primitive.pink-light}" },
      "bg-inverse":     { "$type": "color", "$value": "{color.primitive.ink-surface}" },
      "bg-highlight":   { "$type": "color", "$value": "{color.primitive.yellow}" },
      "text-default":   { "$type": "color", "$value": "{color.primitive.ink}" },
      "text-muted":     { "$type": "color", "$value": "{color.primitive.grey}" },
      "text-accent":    { "$type": "color", "$value": "{color.primitive.marsala}" },
      "text-on-accent": { "$type": "color", "$value": "{color.primitive.white}" },
      "action-primary": { "$type": "color", "$value": "{color.primitive.marsala}" },
      "action-primary-hover": { "$type": "color", "$value": "{color.primitive.yellow}" },
      "border-default": { "$type": "color", "$value": "rgba(28,20,16,0.10)" },
      "border-strong":  { "$type": "color", "$value": "{color.primitive.ink}" },
      "border-accent":  { "$type": "color", "$value": "{color.primitive.pink}" }
    }
  },
  "font": {
    "family": {
      "display": { "$type": "fontFamily", "$value": "Fraunces, serif" },
      "mono":    { "$type": "fontFamily", "$value": "'DM Mono', monospace" },
      "body":    { "$type": "fontFamily", "$value": "Outfit, sans-serif" }
    },
    "weight": {
      "light":  { "$type": "number", "$value": 300 },
      "regular":{ "$type": "number", "$value": 400 },
      "medium": { "$type": "number", "$value": 500 },
      "bold":   { "$type": "number", "$value": 700 },
      "black":  { "$type": "number", "$value": 900 }
    },
    "size": {
      "display-hero":    { "$type": "dimension", "$value": "clamp(56px, 7.5vw, 108px)" },
      "display-contact": { "$type": "dimension", "$value": "clamp(56px, 9vw, 112px)" },
      "display-section": { "$type": "dimension", "$value": "clamp(40px, 5vw, 64px)" },
      "stat":            { "$type": "dimension", "$value": "52px" },
      "badge-num":       { "$type": "dimension", "$value": "28px" },
      "case-title":      { "$type": "dimension", "$value": "26px" },
      "quote":           { "$type": "dimension", "$value": "20px" },
      "body-lg":         { "$type": "dimension", "$value": "18px" },
      "body":            { "$type": "dimension", "$value": "17px" },
      "body-sm":         { "$type": "dimension", "$value": "15px" },
      "caption":         { "$type": "dimension", "$value": "14px" },
      "label":           { "$type": "dimension", "$value": "12px" },
      "label-sm":        { "$type": "dimension", "$value": "11px" },
      "eyebrow":         { "$type": "dimension", "$value": "10px" }
    },
    "tracking": {
      "display-tight": { "$type": "dimension", "$value": "-3px" },
      "section-tight": { "$type": "dimension", "$value": "-1.5px" },
      "logo":          { "$type": "dimension", "$value": "0.05em" },
      "tag":           { "$type": "dimension", "$value": "0.06em" },
      "caption":       { "$type": "dimension", "$value": "0.08em" },
      "button":        { "$type": "dimension", "$value": "0.10em" },
      "nav-cta":       { "$type": "dimension", "$value": "0.12em" },
      "nav":           { "$type": "dimension", "$value": "0.15em" },
      "eyebrow":       { "$type": "dimension", "$value": "0.20em" }
    },
    "leading": {
      "display": { "$type": "number", "$value": 0.92 },
      "title":   { "$type": "number", "$value": 1.15 },
      "snug":    { "$type": "number", "$value": 1.5 },
      "body":    { "$type": "number", "$value": 1.65 },
      "relaxed": { "$type": "number", "$value": 1.75 }
    }
  },
  "space": {
    "1":  { "$type": "dimension", "$value": "6px" },
    "2":  { "$type": "dimension", "$value": "8px" },
    "3":  { "$type": "dimension", "$value": "12px" },
    "4":  { "$type": "dimension", "$value": "16px" },
    "5":  { "$type": "dimension", "$value": "20px" },
    "6":  { "$type": "dimension", "$value": "24px" },
    "7":  { "$type": "dimension", "$value": "28px" },
    "8":  { "$type": "dimension", "$value": "32px" },
    "9":  { "$type": "dimension", "$value": "36px" },
    "10": { "$type": "dimension", "$value": "48px" },
    "11": { "$type": "dimension", "$value": "64px" },
    "12": { "$type": "dimension", "$value": "80px" },
    "13": { "$type": "dimension", "$value": "120px" },
    "14": { "$type": "dimension", "$value": "160px" }
  },
  "radius": {
    "sm":    { "$type": "dimension", "$value": "12px" },
    "md":    { "$type": "dimension", "$value": "16px" },
    "pill":  { "$type": "dimension", "$value": "100px" },
    "arch":  { "$type": "dimension", "$value": "200px 200px 24px 24px" }
  },
  "border": {
    "hairline": { "$type": "dimension", "$value": "1px" },
    "control":  { "$type": "dimension", "$value": "1.5px" },
    "strong":   { "$type": "dimension", "$value": "2px" },
    "frame":    { "$type": "dimension", "$value": "3px" }
  },
  "shadow": {
    "sticker": { "$type": "shadow", "$value": "4px 4px 0 #1C1410" },
    "lift":    { "$type": "shadow", "$value": "0 12px 40px rgba(139,26,46,0.12)" }
  },
  "motion": {
    "duration": {
      "instant": { "$type": "duration", "$value": "200ms" },
      "fast":    { "$type": "duration", "$value": "250ms" },
      "medium":  { "$type": "duration", "$value": "300ms" },
      "slow":    { "$type": "duration", "$value": "400ms" },
      "reveal":  { "$type": "duration", "$value": "700ms" },
      "reveal-slow": { "$type": "duration", "$value": "1000ms" }
    },
    "loop": {
      "marquee-hero": { "$type": "duration", "$value": "22000ms" },
      "marquee-work": { "$type": "duration", "$value": "18000ms" },
      "star-spin":    { "$type": "duration", "$value": "4000ms" },
      "star-float":   { "$type": "duration", "$value": "3000ms" }
    },
    "easing": {
      "default": { "$type": "cubicBezier", "$value": "ease" },
      "linear":  { "$type": "cubicBezier", "$value": "linear" },
      "in-out":  { "$type": "cubicBezier", "$value": "ease-in-out" }
    },
    "offset": {
      "reveal-up":    { "$type": "dimension", "$value": "28px" },
      "reveal-x":     { "$type": "dimension", "$value": "40px" },
      "hover-lift":   { "$type": "dimension", "$value": "-2px" },
      "hover-lift-lg":{ "$type": "dimension", "$value": "-4px" },
      "hover-slide":  { "$type": "dimension", "$value": "8px" }
    }
  }
}
